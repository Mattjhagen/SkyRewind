[Unit]
Description=SkyRewind Web Server
After=network.target

[Service]
Type=simple
User=skyrewind
Group=skyrewind
WorkingDirectory=/opt/skyrewind
Environment="FLASK_DEBUG=false"
ExecStart=/opt/skyrewind/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 backend.app:app
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
